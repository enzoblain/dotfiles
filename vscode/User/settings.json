{
  "workbench.colorTheme": "Atom One Dark",
  "workbench.iconTheme": "material-icon-theme",
  "editor.formatOnSave": true,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--", "-D", "warnings"],
  "explorer.confirmDelete": false,
  "files.associations": {
    "*.{a80,z80,asm,inc,s}": "asm-collection",
    "*.{list,lis}": "asm-list-file",
  },
  "git.confirmSync": false,
  "explorer.confirmDragAndDrop": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "explorer.confirmPasteNative": false,
  "haskell.manageHLS": "GHCup",
  "svelte.enable-ts-plugin": true,
  "terminal.integrated.initialHint": false,
  "js/ts.updateImportsOnFileMove.enabled": "never",
  "cmake.environment": {
    "PATH": "/Users/enzoblain/.vscode/extensions/stmicroelectronics.stm32cube-ide-build-cmake-1.45.0-darwin-arm64/resources/cube-cmake/darwin/aarch64:/Users/enzoblain/.vscode/extensions/stmicroelectronics.stm32cube-ide-core-1.3.0-darwin-arm64/resources/binaries/darwin/aarch64:${env.PATH}"
  },
  "debug.allowBreakpointsEverywhere": true,
  "C_Cpp.intelliSenseEngine": "disabled",
  "update.showReleaseNotes": false,
}
